# TrustFL Environment Template — copy to .env and fill in secrets
# DO NOT commit .env to source control.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=trustfl
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=trustfl
DATABASE_URL=postgresql://trustfl:CHANGE_ME_IN_PRODUCTION@db:5432/trustfl

# ── Blockchain ───────────────────────────────────────────────────────────────
WEB3_PROVIDER_URI=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Coordinator signing private key — use KMS in production, never commit
COORDINATOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── IPFS / Storage ───────────────────────────────────────────────────────────
IPFS_URL=http://127.0.0.1:5001
STORAGE_BACKEND=ipfs   # or 'local' for dev

# ── Coordinator ──────────────────────────────────────────────────────────────
COORDINATOR_PORT=8100
FL_MIN_CLIENTS=2
FL_NUM_ROUNDS=3
FL_ROUND_TIMEOUT_SECONDS=60
FL_HEARTBEAT_TIMEOUT_SECONDS=30

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
