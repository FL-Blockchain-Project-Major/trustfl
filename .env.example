# TrustFL environment template. Copy to .env for local development.
# Production must provide CHANGE_ME values through a secret manager.
# Never expose API_SECRET_KEY or private keys as NEXT_PUBLIC_* variables.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=trustfl
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=trustfl
ENVIRONMENT=development
DATABASE_URL=postgresql://trustfl:CHANGE_ME_IN_PRODUCTION@db:5432/trustfl

# ── Blockchain ───────────────────────────────────────────────────────────────
WEB3_PROVIDER_URI=http://127.0.0.1:8545
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Coordinator signing private key — use KMS in production, never commit
COORDINATOR_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── IPFS / Storage ───────────────────────────────────────────────────────────
# Compose-only internal endpoint; the IPFS API is intentionally not host-published.
IPFS_URL=http://ipfs:5001
STORAGE_BACKEND=ipfs   # or 'local' for dev

# ── Coordinator ──────────────────────────────────────────────────────────────
COORDINATOR_PORT=8100
FL_MIN_CLIENTS=2
FL_NUM_ROUNDS=3
FL_ROUND_TIMEOUT_SECONDS=60
FL_HEARTBEAT_TIMEOUT_SECONDS=30

# ── Federated Learning clients ───────────────────────────────────────────────
# Number of client workers to launch.  Must satisfy FL_MIN_CLIENTS <= FL_NUM_CLIENTS.
# Supported range: 1–N (tested at 1, 2, 3).
FL_NUM_CLIENTS=2

# Host-side raw dataset root mounted read-only into every client container.
# Run  scripts/generate_sample_dataset.py  to create a synthetic sample:
#   python scripts/generate_sample_dataset.py --out-dir datasets/sample --num-images 60
#
# Supported directory layouts (auto-detected):
#   Standard:   <root>/train/images/ + <root>/train/annotations/
#               <root>/val/images/   + <root>/val/annotations/   (optional)
#   Train/val:  <root>/images/train/ + <root>/annotations/train/
#   Flat:       <root>/images/       + <root>/annotations/
#
# Image formats: .jpg, .jpeg, .png, .bmp, .tiff, .tif
# Annotation format: VisDrone2019 (one .txt per image,
#   each line: x,y,w,h,score,category,truncation,occlusion)
#
# ⚠ SINGLE-HOST NOTICE: In this default topology all client replicas mount
#   the same host directory.  This exercises federated aggregation and
#   cryptographic verification protocols on a single machine; it does NOT
#   demonstrate data privacy, data isolation, or statistical heterogeneity
#   across genuinely independent data owners.  See DEPLOYMENT.md §5.
FL_DATASET_DIR=./datasets/sample

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_AUTH_REQUIRED=true
API_READ_KEY=CHANGE_ME_IN_PRODUCTION
API_WRITE_KEY=CHANGE_ME_IN_PRODUCTION
API_ADMIN_KEY=CHANGE_ME_IN_PRODUCTION
API_LEGACY_AUTH_COMPAT=false
API_RATE_LIMIT=100/minute
TRUSTED_PROXY_IPS=

# ── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REFRESH_INTERVAL_SECONDS=30
DASHBOARD_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
NEXT_PUBLIC_API_READ_KEY=CHANGE_ME_IN_PRODUCTION
NEXT_PUBLIC_DASHBOARD_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION

# ── Client identity/signing ─────────────────────────────────────────────────
FL_FEDERATION_ID=fed-default
FL_IDENTITY_PATH=/var/lib/trustfl/keys/client_001/private.pem
COORDINATOR_REQUIRE_SIGNATURES=true
COORDINATOR_ENROLLMENT_TOKEN=CHANGE_ME_IN_PRODUCTION
# Required outside explicitly insecure development: JSON map of client ID to its
# provisioned Ed25519 public key, e.g. {"client_001":"base64-public-key"}.
COORDINATOR_ENROLLMENT_ALLOWLIST={}
# Path to allowlist.json written by client-init (used by Compose stack).
# COORDINATOR_ENROLLMENT_ALLOWLIST_FILE=/var/lib/trustfl/keys/allowlist.json
# Never enable in production. It permits the legacy shared-token flow only.
COORDINATOR_INSECURE_DEV_AUTH=false
# Clip each submitted FedAvg weight after collection; this is order-independent.
FL_MAX_CLIENT_WEIGHT_SHARE=0.5
# Bound L2 norm of update delta from global model. 0 disables clipping.
FL_MAX_UPDATE_NORM=1.0
FL_FINALIZE_MAX_RETRIES=5
FL_FINALIZE_RETRY_BASE_SECONDS=1
STORAGE_LOCAL_DIR=/data/artifacts
IPFS_CONNECT_TIMEOUT_SECONDS=5
IPFS_READ_TIMEOUT_SECONDS=30
