# Environment Configuration Template for TrustFL
# Copy this file to .env before starting services: cp .env.example .env

# General
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-this-insecure-key-to-a-cryptographically-strong-secret-32-bytes-min

# Coordinator Service
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8001
MIN_CLIENTS_PER_ROUND=3
ROUND_TIMEOUT_SECONDS=300

# Client Service
CLIENT_ID=client-1
CLIENT_PRIVATE_KEY_PATH=./keys/client.pem
COORDINATOR_URL=http://localhost:8001

# FastAPI Backend / API Gateway
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Next.js Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_URL=http://localhost:8545
PORT=3000

# Blockchain / EVM Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
AGGREGATOR_CONTRACT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# IPFS / Decentralized / Object Storage
STORAGE_BACKEND=ipfs # Options: ipfs, s3, local
IPFS_GATEWAY=http://127.0.0.1:8080
IPFS_API_URL=http://127.0.0.1:5001
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=trustfl-artifacts

# Zero-Knowledge Verifier Configuration
ZK_VERIFIER_ENABLED=true
ZK_CIRCUIT_PATH=./zk/build
